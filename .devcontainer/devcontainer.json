{
  "name": "tsuchinoko Flutter Web",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/flutter/bin"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Flutter Web", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter", "anthropic.claude-code"],
      "settings": {
        "dart.flutterSdkPath": "/home/vscode/flutter"
      }
    }
  }
}
